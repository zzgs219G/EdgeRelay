{
  "name": "edge-relay",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that relays APK build jobs to GitHub Actions, hiding the GitHub token and repo coordinates from the mobile client.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build:frontend": "npm --prefix frontend run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.node.config.ts",
    "test:workers": "vitest run",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20250410.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  }
}
